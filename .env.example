# Voice of Customer Radar — Next.js on Vercel
# Copy this file to .env.local for local development. Never commit .env.local.

# Optional: public web-discovery via Tavily search API.
# Get a free key at https://app.tavily.com/home (free tier: ~1,000 credits/mo, no card required).
# The dashboard and report APIs work without this key; web discovery requires it.
TAVILY_API_KEY=

# Optional: AI root-cause tagging for uploaded reviews (server-side only).
# Without a key the dashboard uses deterministic tags and no data leaves the browser.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: production marketplace integrations (not used by the demo sync).
# Shopify reviews come from a reviews app metafield token held server-side only.
# Amazon needs a third-party review-scraper key, e.g. https://rainforestapi.com.
SHOPIFY_API_KEY=
RAINFOREST_API_KEY=
